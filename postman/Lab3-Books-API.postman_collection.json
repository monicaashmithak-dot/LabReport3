{
  "info": {
    "name": "Lab 3 Books REST API",
    "description": "REST API tests for book CRUD, query parameters, validation, and debugging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Get all books",
      "request": { "method": "GET", "url": "{{baseUrl}}/books" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Returns books array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }]
    },
    {
      "name": "Search books by title",
      "request": { "method": "GET", "url": "{{baseUrl}}/books?search_q=code" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Sort books ascending",
      "request": { "method": "GET", "url": "{{baseUrl}}/books?order_by=price&order=ASC" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Sort books descending",
      "request": { "method": "GET", "url": "{{baseUrl}}/books?order_by=price&order=DESC" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Paginate books",
      "request": { "method": "GET", "url": "{{baseUrl}}/books?limit=2&offset=1" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Limit is respected', function () { pm.expect(pm.response.json().data.length).to.be.at.most(2); });"] } }]
    },
    { "name": "Filter minimum price", "request": { "method": "GET", "url": "{{baseUrl}}/books?min_price=500" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }] },
    { "name": "Filter maximum price", "request": { "method": "GET", "url": "{{baseUrl}}/books?max_price=500" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }] },
    { "name": "Filter both price limits", "request": { "method": "GET", "url": "{{baseUrl}}/books?min_price=300&max_price=700" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }] },
    { "name": "Get book by ID", "request": { "method": "GET", "url": "{{baseUrl}}/books/1" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }] },
    { "name": "Get nonexistent book", "request": { "method": "GET", "url": "{{baseUrl}}/books/9999" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 404', function () { pm.response.to.have.status(404); });"] } }] },
    {
      "name": "Create book successfully",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Introduction to Algorithms\",\n  \"author\": \"Thomas Cormen\",\n  \"price\": 899.99\n}" },
        "url": "{{baseUrl}}/books"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"] } }]
    },
    {
      "name": "Create book with missing title",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"author\": \"Test Author\",\n  \"price\": 100\n}" }, "url": "{{baseUrl}}/books" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "Create book with missing author",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Test Book\",\n  \"price\": 100\n}" }, "url": "{{baseUrl}}/books" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "Create book with invalid price",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Test Book\",\n  \"author\": \"Test Author\",\n  \"price\": \"expensive\"\n}" }, "url": "{{baseUrl}}/books" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "Get invalid book ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/books/not-a-number" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "Update book",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Book\",\n  \"author\": \"Updated Author\",\n  \"price\": 499.99\n}" }, "url": "{{baseUrl}}/books/1" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Delete a book",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/books/1" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }]
    }
  ]
}
